<?xml version="1.0" encoding="utf-8"?>
<!-- The 1 x 1 widget: a stack with a card per connected controller; swiping down snaps to the
     next. ControllersWidget sizes and places the stack so that its front card covers the panel
     and the cards behind fall outside it, where the panel clips them. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel"
    android:clipToOutline="true"
    android:foreground="@drawable/widget_panel_rim">

    <StackView
        android:id="@+id/widget_stack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="top|left"
        android:loopViews="true"
        android:theme="@style/WidgetStackTheme" />

    <LinearLayout
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:alpha="0.45"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_art_lines" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="4dp"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/no_controllers"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>
</FrameLayout>
