<?xml version="1.0" encoding="utf-8"?>
<!-- One controller in the widget, drawn as in the app: lines over a glow of its light colour,
     its name, battery and connection; on the right a pill with a dot per connected controller,
     the white thumb on this one's. Only the front card shows, so the pill stays in place while
     its thumb moves from card to card. ControllersWidget tints and fills it.
     StackView measures cards "at most" its size and spreads smaller ones apart; the large
     minimum makes every card take the whole size. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="2000dp"
    android:minHeight="2000dp"
    android:background="@drawable/widget_card_background">

    <ImageView
        android:id="@+id/card_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_glow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="9dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/card_touchpad"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_art_touchpad" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_art_lines" />
        </FrameLayout>

        <TextView
            android:id="@+id/card_name"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="1dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/card_level"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/card_bolt"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bolt"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/card_transport"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bluetooth" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/card_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="4dp"
        android:background="@drawable/widget_dots_track"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="1.5dp" />
</FrameLayout>
